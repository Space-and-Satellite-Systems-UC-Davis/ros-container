{
  "name": "ROS 2 ${templateOption:rosDistro}",
  "image": "ghcr.io/space-and-satellite-systems-uc-davis/ros-container:${templateOption:rosDistro}",
  "remoteEnv": {
    "ROS_DISTRO": "${templateOption:rosDistro}",
    "DISPLAY": ":1"
  },
  "forwardPorts": [5901, 6080],
  "portsAttributes": {
    "5901": {
      "label": "TigerVNC",
      "onAutoForward": "notify"
    },
    "6080": {
      "label": "noVNC",
      "onAutoForward": "notify"
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "ms-python.python",
        "ms-vscode.cmake-tools",
        "ranch-hand-robotics.rde-pack",

      ]
    }
  },
  "workspaceFolder": "/workspace",
  "postStartCommand": "if command -v start-vnc.sh >/dev/null 2>&1; then nohup start-vnc.sh >/tmp/vnc-startup.log 2>&1 </dev/null & fi"
}
